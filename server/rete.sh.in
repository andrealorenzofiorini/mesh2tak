#!/usr/bin/env bash
# =============================================================================
#  Rete Meshtastic sul server infra-TAK  (mesh2tak @@VERSIONE@@)
#
#  Pagina https://meshtastic.<dominio> con lo stato di tutti i ponti Meshtastic -> TAK, da cui si
#  aggiungono e tolgono i ponti; per ognuno la gestione del suo nodo a https://meshtastic-<nome>.<dominio>.
#  Tutto dietro Authentik, solo per il gruppo "authentik Admins". I Raspberry arrivano con un tunnel SSH
#  aperto da loro: a casa non si apre nessuna porta. Nessun pacchetto nuovo: usa sshd, Caddy, Authentik
#  e il python3 di Ubuntu. Dalla 1.5.0 resta acceso un piccolo servizio senza privilegi (mesh2tak-rete-web,
#  solo su 127.0.0.1) che riceve le richieste dei Raspberry e le azioni della pagina; dalla 1.7.0 controlla
#  anche i ponti ogni minuto e avvisa per email con la posta di infra-TAK (destinatari di Guard Dog).
#
#  Uso (da root sul server della console infra-TAK):
#    sudo bash rete-meshtastic.sh installa      una volta sola (e dopo aver aggiornato questo script)
#    sudo bash rete-meshtastic.sh elenco        ponti e tunnel collegati
#    sudo bash rete-meshtastic.sh disinstalla   toglie tutto
#  I ponti si aggiungono dalla pagina: sul Raspberry
#    sudo bash installa-ponte-meshtastic.sh --accesso-esterno
#  e sulla pagina si approva la sua richiesta. A mano: aggiungi NOME 'CHIAVE', rimuovi NOME.
# =============================================================================
set -euo pipefail
case "${1:-}" in -h|--help|"") sed -n '2,20p' "$0"; exit 0 ;; esac
[ "$(id -u)" -eq 0 ] || { echo "Va avviato da root:  sudo bash $0 $*" >&2; exit 1; }
command -v python3 >/dev/null || { echo "Manca python3 (su Ubuntu c'e' sempre: sudo apt install python3)" >&2; exit 1; }
TMP=$(mktemp -d); chmod 700 "$TMP"
trap 'rm -rf "$TMP"' EXIT
cat > "$TMP/rete_meshtastic.py" <<'FINE_RETE_PY'
@@RETE_PY@@
FINE_RETE_PY
ESITO=0
python3 -I "$TMP/rete_meshtastic.py" "$@" || ESITO=$?
exit "$ESITO"
